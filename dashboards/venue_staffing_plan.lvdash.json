{
  "datasets": [
    {
      "name": "ds_coverage",
      "displayName": "Staff needed vs. on duty (hourly)",
      "queryLines": [
        "SELECT venue_id, venue_name, park, initcap(replace(venue_type, '_', ' ')) AS venue_type, date, hour, role,\n",
        "       required_staff, scheduled_staff, scheduled_staff - required_staff AS extra_staff, understaffed\n",
        "FROM venue_staffing_coverage\n"
      ],
      "columns": [
        {
          "displayName": "Staffing buffer",
          "description": "Scheduled staff-hours above what demand needs",
          "expression": "SUM(`scheduled_staff`) / SUM(`required_staff`) - 1"
        },
        {
          "displayName": "Staff-hours above need",
          "description": "Scheduled minus needed staff-hours",
          "expression": "SUM(`scheduled_staff`) - SUM(`required_staff`)"
        },
        {
          "displayName": "day",
          "description": "Date as text, without time, for the Day filter",
          "expression": "date_format(`date`, 'yyyy-MM-dd (EEE)')"
        }
      ]
    },
    {
      "name": "ds_shifts",
      "displayName": "Shift schedule",
      "queryLines": [
        "SELECT s.date, s.venue_id, s.venue_name, v.park, initcap(replace(v.venue_type, '_', ' ')) AS venue_type, s.role,\n",
        "       s.shift_start, s.shift_end, s.shift_hours, s.staff_count,\n",
        "       s.staff_count * s.shift_hours AS staff_hours,\n",
        "       CONCAT(LPAD(CAST(s.shift_start AS STRING), 2, '0'), ':00') AS start_time,\n",
        "       CONCAT(LPAD(CAST(s.shift_end AS STRING), 2, '0'), ':00') AS end_time,\n",
        "       date_format(s.date, 'yyyy-MM-dd (EEE)') AS day\n",
        "FROM venue_staff_schedule s\n",
        "JOIN venues v ON v.venue_id = s.venue_id\n"
      ]
    },
    {
      "name": "ds_demand",
      "displayName": "Guest demand: last 8 weeks and forecast",
      "queryLines": [
        "WITH demand AS (\n",
        "  SELECT venue_id, date, hour, CAST(guests AS DOUBLE) AS actual_guests, CAST(NULL AS DOUBLE) AS forecast_guests\n",
        "  FROM venue_demand_history\n",
        "  WHERE date > date_sub((SELECT MAX(date) FROM venue_demand_history), 56)\n",
        "  UNION ALL\n",
        "  SELECT venue_id, date, hour, CAST(NULL AS DOUBLE) AS actual_guests, forecast_guests\n",
        "  FROM venue_demand_forecast\n",
        ")\n",
        "SELECT d.venue_id, v.venue_name, v.park, initcap(replace(v.venue_type, '_', ' ')) AS venue_type, d.date, d.hour,\n",
        "       date_format(d.date, 'MM-dd EEE') AS day_label, d.actual_guests, d.forecast_guests\n",
        "FROM demand d\n",
        "JOIN venues v ON v.venue_id = d.venue_id\n"
      ],
      "columns": [
        {
          "displayName": "Forecast daily average",
          "description": "Forecast guests per day over the forecast window",
          "expression": "SUM(`forecast_guests`) / COUNT(DISTINCT CASE WHEN `forecast_guests` IS NOT NULL THEN `date` END)"
        },
        {
          "displayName": "Change vs last 8 weeks",
          "description": "Forecast daily average vs. the actual daily average of the last 8 weeks",
          "expression": "(SUM(`forecast_guests`) / COUNT(DISTINCT CASE WHEN `forecast_guests` IS NOT NULL THEN `date` END)) / (SUM(`actual_guests`) / COUNT(DISTINCT CASE WHEN `actual_guests` IS NOT NULL THEN `date` END)) - 1"
        }
      ]
    }
  ],
